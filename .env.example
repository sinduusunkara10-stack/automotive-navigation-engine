# Copy to .env for local use. Never commit a real .env (it is gitignored) — this file
# must only ever contain variable names and placeholder values.

# Standard Node environment flag. Leave unset/"development" for local use, "production"
# in a deployed container. "test" is reserved for the automated test suite (npm test /
# npm run test:api set it themselves) — it is the one context where the API server can
# start without NAVIGATION_ENGINE_API_TOKEN configured (see below). Never set NODE_ENV=test
# outside the test suite.
NODE_ENV=development

# Local HTTP API port (see src/api/main.ts). Optional, defaults to 3000.
PORT=3000

# Timeout (ms) for the engine's initial page navigation (src/core/initialNavigation.ts),
# which waits only for "domcontentloaded" -- never "load"/networkidle as a required
# condition, since real pages with long-running analytics/ad traffic may never fire
# "load" at all. Optional; defaults to 30000 if unset. Must be a positive integer, capped
# at a hard maximum (see src/config/initialNavigationConfig.ts) -- an invalid value fails
# server startup clearly rather than silently falling back.
INITIAL_NAVIGATION_TIMEOUT_MS=30000

# Timeout (ms) for navigation triggered by in-loop actions -- the `navigate` action and
# link clicks that cause a document navigation (src/actions/navigate.ts,
# src/actions/click.ts) -- as distinct from INITIAL_NAVIGATION_TIMEOUT_MS above. Also
# waits only for "domcontentloaded", never "load"/networkidle. Optional; defaults to
# 30000 if unset. Must be a positive integer, capped at a hard maximum (see
# src/config/actionNavigationConfig.ts) -- an invalid value fails server startup clearly
# rather than silently falling back.
ACTION_NAVIGATION_TIMEOUT_MS=30000

# Required bearer token for POST /v1/tasks and GET /v1/tasks/:runId (see src/api/auth.ts).
# GET /v1/health stays unauthenticated. Callers must send:
#   Authorization: Bearer <token>
# Generate a long random value for real use, e.g. `openssl rand -hex 32`. The server
# refuses to start outside NODE_ENV=test if this is unset — never commit a real token.
NAVIGATION_ENGINE_API_TOKEN=replace-with-a-long-random-secret-never-committed

# Selects the reasoning provider. "mock" (default if unset) uses the deterministic
# MockReasoningProvider against local fixtures. "claude" uses the real Claude-backed
# ClaudeReasoningProvider (src/reasoning/claudeReasoningProvider.ts) and requires
# ANTHROPIC_API_KEY below. Any other value fails clearly at startup.
REASONING_PROVIDER=mock

# Required only when REASONING_PROVIDER=claude. Get one from
# https://console.anthropic.com/ — never commit a real key.
ANTHROPIC_API_KEY=sk-ant-placeholder-do-not-commit-a-real-key

# Optional tuning for ClaudeReasoningProvider (see src/reasoning/config.ts for defaults
# and hard ceilings). All are optional; sane conservative defaults apply if unset.
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_OUTPUT_TOKENS=1024
CLAUDE_TIMEOUT_MS=15000
# Hard-capped at 1 regardless of this value (see src/reasoning/config.ts).
CLAUDE_MAX_RETRIES=1
CLAUDE_MIN_CONFIDENCE=0.5

# Selects the run-record persistence backend (src/api/taskStoreFactory.ts). "memory"
# (default if unset) is the in-process, non-persistent store used for local development
# and tests -- every run record is lost on process restart. "redis" is the opt-in
# production backend: run records survive an API process restart (e.g. an out-of-memory
# kill on a small instance), because they live in Redis rather than the killed process's
# own memory. Requires REDIS_URL below. Any other value fails clearly at startup.
TASK_STORE=memory

# Required only when TASK_STORE=redis. A standard redis:// or rediss:// connection URL.
# The server connects and verifies reachability once at startup and fails clearly (rather
# than starting and failing per-run) if Redis cannot be reached.
# REDIS_URL=redis://localhost:6379

# How long (seconds) a run record -- running, completed, or failed -- is retained before
# it expires (see src/config/taskStoreConfig.ts). Applies to both backends: the in-memory
# store evicts lazily on read past this age; the Redis store sets/refreshes a native key
# TTL on every write. Optional; defaults to 86400 (24h) if unset.
TASK_RECORD_TTL_SECONDS=86400

# How often (ms) an actively-running task refreshes its own run record's updatedAt/worker
# ownership (src/api/runner.ts). Optional; defaults to 15000 if unset.
HEARTBEAT_INTERVAL_MS=15000

# How long (ms) a "running" record can go without a heartbeat before a reader treats it as
# stale rather than indefinitely "running" (src/api/staleDetection.ts) -- the run's owning
# process may be gone (staleReason "worker_lost", e.g. after an out-of-memory restart) or
# the run itself may simply be hung (staleReason "run_stale"). Optional; defaults to 90000
# if unset.
RUN_STALE_THRESHOLD_MS=90000

# Ceiling on how many runs may be simultaneously in flight (src/api/concurrencyLimiter.ts).
# Each accepted run launches its own full Chromium instance, which is a meaningful
# fraction of a small (e.g. 512MB) instance's memory budget -- POST /v1/tasks returns 503
# once this many runs are already in progress. Optional; defaults conservatively to 1 if
# unset.
MAX_CONCURRENT_TASKS=1

# Whole-run cap on captures.screenshots (src/config/captureLimits.ts). Preserves the
# first 2 screenshots (how the run started) alongside the most recent ones (how it
# ended) rather than simply dropping the oldest. Optional; defaults to 20 if unset.
MAX_SCREENSHOTS_PER_RUN=20

# Whole-run cap on TaskResponse.steps (src/config/captureLimits.ts). Preserves the first
# 5 steps alongside the most recent ones. Optional; defaults to 50 if unset. Only bounds
# what's *stored* in the response -- never the live decision-making loop's own history.
MAX_STORED_STEPS=50

# Per-stored-observation cap on observation.interactiveElements (src/config/
# captureLimits.ts). Splits the budget between the earliest and latest (DOM-order)
# elements rather than simply dropping the tail, where terminal-route controls
# frequently land. Optional; defaults to 100 if unset. Only bounds what's *stored* --
# never the live observation the reasoning/validation loop uses to decide and validate
# actions.
MAX_STORED_INTERACTIVE_ELEMENTS_PER_OBSERVATION=100

# Opt-in low-memory browser mode (src/config/lowMemoryBrowserConfig.ts,
# src/api/browserResourceRouting.ts). Only the literal string "true" (case-insensitive)
# enables it; anything else, including unset, leaves it off with zero behavior change.
# When enabled, image/media/font network requests are fulfilled with a minimal stand-in
# response instead of reaching the origin server, and service worker registration is
# disabled for the run's page -- document/script/stylesheet/xhr/fetch navigation and GA4/
# dataLayer capture are all unaffected. See docs/architecture.md §14 "Low-memory browser
# mode". Rollback: unset this variable (or set it to anything other than "true").
# LOW_MEMORY_BROWSER_MODE=true

# Optional, purely diagnostic: the deployed commit SHA, surfaced at GET /v1/health so an
# operator can confirm which commit is actually serving traffic (see
# src/config/deploymentInfo.ts). RENDER_GIT_COMMIT is set automatically by Render for a
# service backed by a connected git repo -- no action needed there. GIT_COMMIT_SHA is a
# generic fallback for any other platform/CI, or a manual override; only used if
# RENDER_GIT_COMMIT is unset. Neither affects engine behaviour if left unset.
# RENDER_GIT_COMMIT=
# GIT_COMMIT_SHA=

# Copy to .env for local use. Never commit a real .env (it is gitignored) — this file
# must only ever contain variable names and placeholder values.

# Selects the reasoning provider. "mock" (default if unset) uses the deterministic
# MockReasoningProvider against local fixtures. "claude" uses the real Claude-backed
# ClaudeReasoningProvider (src/reasoning/claudeReasoningProvider.ts) and requires
# ANTHROPIC_API_KEY below. Any other value fails clearly at startup.
REASONING_PROVIDER=mock

# Required only when REASONING_PROVIDER=claude. Get one from
# https://console.anthropic.com/ — never commit a real key.
ANTHROPIC_API_KEY=sk-ant-placeholder-do-not-commit-a-real-key

# Optional tuning for ClaudeReasoningProvider (see src/reasoning/config.ts for defaults
# and hard ceilings). All are optional; sane conservative defaults apply if unset.
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_OUTPUT_TOKENS=1024
CLAUDE_TIMEOUT_MS=15000
# Hard-capped at 1 regardless of this value (see src/reasoning/config.ts).
CLAUDE_MAX_RETRIES=1
CLAUDE_MIN_CONFIDENCE=0.5

# Local HTTP API port (see src/api/main.ts). Optional, defaults to 3000.
PORT=3000

  "limits": {
    "maxSteps": 60,
    "maxBacktracks": 5,
    "maxDurationSeconds": 900,
    "maxRepeatedActions": 3
  },
  "safety": {
    "allowedActions": [
      "click",
      "scroll",
      "wait",
      "go_back",
      "navigate",
      "capture",
      "stop_success",
      "stop_blocked",
      "stop_failure"

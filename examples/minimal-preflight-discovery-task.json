{
  "schemaVersion": "1.1.0",
  "taskId": "example-minimal-preflight-discovery-0001",
  "objective": "Starting from the homepage, find and enter the vehicle configurator and proceed through the configuration steps to a finish or summary state.",
  "startUrl": "https://www.example-automotive-oem.com/",
  "journeyType": "configurator-journey",
  "successCriteria": [
    {
      "id": "reached-finish-state",
      "type": "element_present",
      "description": "The configurator has reached a finish/summary screen showing the completed build.",
      "config": {
        "selector": "[data-testid=\"configurator-summary\"]"
      },
      "required": true
    }
  ],
  "captureModules": [
    "page_visits",
    "journey_path",
    "screenshots",
    "errors"
  ],
  "limits": {
    "maxSteps": 60,
    "maxBacktracks": 5,
    "maxDurationSeconds": 900,
    "maxRepeatedActions": 3
  },
  "safety": {
    "allowedActions": [
      "click",
      "scroll",
      "wait",
      "go_back",
      "navigate",
      "capture",
      "stop_success",
      "stop_blocked",
      "stop_failure"
    ],
    "allowFormSubmission": false,
    "allowPaymentOrPurchase": false,
    "allowPersonalDataEntry": false,
    "requireDomainConfirmationOnRedirect": true
  },
  "outputSchemaVersion": "1.2.0",
  "metadata": {
    "useCase": "minimal-preflight-domain-discovery",
    "requestedBy": "n8n-workflow-demo"
  }
}
